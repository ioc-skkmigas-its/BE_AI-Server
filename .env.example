# ─── Application ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_a_secure_random_key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Auto Migration ──────────────────────────────────────────
# If true, app startup will create ranking table/indexes automatically.
ENABLE_AUTO_MIGRATION=true
# Recommended: Supabase PostgreSQL connection string for DDL migration.
# Example: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=

# ─── SQLite (user auth local cache) ───────────────────────────
DATABASE_URL=sqlite:///./ranking.db

# ─── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://jwxvmwcqqieqdmxkwslf.supabase.co

# Anon key (public, safe for read operations)
SUPABASE_ANON_KEY=sb_publishable_949tHPuVOWrXvT5CyVoC3A_2hgV447Q

# Service role key — REQUIRED for backend writes to Supabase
# Supabase Dashboard → Project Settings → API → service_role key
# ⚠️  NEVER expose this key on the frontend
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Table names (change if your schema differs)
SUPABASE_WELLS_TABLE=trident_well_monthlies
SUPABASE_MONTHLY_TABLE=trident_well_monthlies
SUPABASE_STATIC_WELLS_TABLE=trident_wells
SUPABASE_READ_PAGE_SIZE=1000
SUPABASE_WRITE_CHUNK_SIZE=500
SUPABASE_RANKINGS_TABLE=well_ranking_predictions
RANKING_UPSERT_CONFLICT_KEYS=record_key

# ─── XGBoost Ranking Model ───────────────────────────────────
# Source ZIP bundle from mature-field model artifacts
ARTIFACT_BUNDLE_ZIP_PATH=./mature-field-candidate-ranking-v4-final-20260414-014711-main.zip
# Runtime extraction directory for model artifacts
ARTIFACT_EXTRACT_DIR=./data/model_artifacts
# Model extension can be .kpl/.pkl/.joblib/.json/.ubj/.bst
XGBOOST_MODEL_PATH=./data/model_artifacts/uplift_base_model.joblib
# Optional preprocessing pipeline serialized with joblib
XGBOOST_PREPROCESSOR_PATH=./data/model_artifacts/preprocessor.joblib
# Optional manifest containing feature_cols/id_cols
XGBOOST_FEATURE_MANIFEST_PATH=./data/model_artifacts/artifact_manifest.json

# ─── Hugging Face ─────────────────────────────────────────────
# https://huggingface.co/settings/tokens → New token → Type: Read
HF_TOKEN=your_hf_read_token_here
HF_MODEL_REPO=anekazek/msf-ranking-model-final-20260413-075146
MODEL_BUNDLE_FILENAME=msf_ranking_inference_bundle.zip
MODEL_CACHE_DIR=./data/model

# ─── Scheduler ────────────────────────────────────────────────
# Weekly ranking job schedule (UTC)
# day_of_week: mon, tue, wed, thu, fri, sat, sun
RANKING_SCHEDULE_DAY=mon
RANKING_SCHEDULE_HOUR=2
RANKING_SCHEDULE_MINUTE=0
